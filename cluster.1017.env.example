# DeepSeek-V4.1-Flash-1017 (deepseek-ai, revision 1bae0e10, released 2026-10-17) on the release
# lane's image, patch set and flags: config.json, the tensor index and the inference code are
# byte-identical to the release, all 48 shards are new (weights/manifest-1017-1bae0e10.tsv).
# Copy to cluster.1017.env (git-ignored); it reads cluster.env and changes only the weights.
#
# Laying it out next to the serving release (docs/RUNBOOK.md, "A new checkpoint"):
#   fetch-files.py ... --exclude 'model-*'      small files (config, index) into MODEL_DIR
#   fetch-engram.py ...                         full Engram shards 47/48 into ENGRAM_CACHE_DIR
#   CLUSTER_ENV=cluster.1017.env launch/cluster.sh slice     every rank's slice
#   then shards 1-46 once on the head and pull-files.py over rail B
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/cluster.env"
MODEL_REPO=deepseek-ai/DeepSeek-V4.1-Flash-1017
MODEL_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170
MODEL_MANIFEST=manifest-1017-1bae0e10.tsv
MODEL_DIR=/var/tmp/models/DeepSeek-V4.1-Flash-1017
ENGRAM_CACHE_DIR=/var/tmp/models/DeepSeek-V4.1-Flash-1017-engram-full
