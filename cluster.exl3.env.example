# The EXL3 lane: bot-lab-21's DeepSeek-V4.1-Flash-EXL3-3.5bpw-Pollard (routed experts at 3.5 bpw,
# every other tensor byte-identical to the release) on Tech2Wild's e47aa780 image chain and patch
# set tp3e. A second deployment next to the release lane: they take turns on the same four nodes
# and the same API address, so its container name, master port and recipe directory differ.
#
# Copy to cluster.exl3.env (git-ignored) and drive it with CLUSTER_ENV=cluster.exl3.env:
#   CLUSTER_ENV=cluster.exl3.env launch/cluster.sh ship      recipe to REPO_DIR below
#   CLUSTER_ENV=cluster.exl3.env launch/cluster.sh render
# then start and stop it as its own deployment (fleet up|down), never beside the release lane.
#
# Model directory per node (weights/fetch-files.py once, weights/pull-files.py over rail B,
# weights/assemble-dir.py against that node's release directory, so the Engram slice is its own).

NODES=(spark-01 spark-02 spark-03 spark-04)
RAIL_A_IPS=(10.77.1.11 10.77.1.12 10.77.1.13 10.77.1.14)
RAIL_A_CIDR=10.77.1.0/24
RAIL_A_IFACE=enp1s0f0np0
RAIL_A_HCA=rocep1s0f0
NCCL_IB_TC=106
RAIL_B_IPS=(10.77.2.11 10.77.2.12 10.77.2.13 10.77.2.14)

REPO_DIR=/home/mtxc/dsv41x

MODEL_DIR=/var/tmp/models/DeepSeek-V4.1-Flash-EXL3
MODEL_MANIFEST=manifest-exl3-f129e31a.tsv
# The Engram slices and engram-local.json are the release's (hardlinked): same revision check.
MODEL_REVISION=dba1be0a40aa45a94ad051997016db3960a90277
CACHE_DIR=/var/tmp/dsv41-vllm-cache
PATCH_ROOT=/var/tmp/dsv41-patches

# build/build-image-capped.sh base (VLLM_PIN=e47aa780bccf59f59dfa2cbb18e17a10b4fe69ba) then cuda-exl3
IMAGE=vllm-dsv41:exl3-e47aa780
CONTAINER=vllm_dsv41x
API_HOST=10.77.1.11
API_PORT=8000
MASTER_PORT=29543

# Same serving shape as the release lane, so the comparison is the checkpoint and its stack.
PATCH_SET=exl3-tp3e
MAXLEN=600000
SPEC_K=3
GMU=0.80
SEQS=8
MAX_BATCHED=8192
# 0xTank's compact output projection is not part of tp3e
COMPACT_O_PROJ=0
LEVER_ENV="NCCL_BUFFSIZE=1048576 NCCL_LL128_BUFFSIZE=262144 NCCL_PROTO=^LL128 NCCL_MAX_NCHANNELS=8"
