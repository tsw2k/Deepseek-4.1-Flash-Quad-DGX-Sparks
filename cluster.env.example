# Copy to cluster.env (git-ignored). One file, identical on the operator host and every node:
# each script picks its own row by rank. Arrays are in rank order; rank 0 serves the API.
#
# Values below are the mtxc cluster. Rail addresses are private fabric addresses; management
# addresses never go in here (ssh names resolve through ~/.ssh/config).

NODES=(spark-01 spark-02 spark-03 spark-04)

# Rail A carries NCCL, Gloo and the vLLM rendezvous, and nothing else.
RAIL_A_IPS=(10.77.1.11 10.77.1.12 10.77.1.13 10.77.1.14)
RAIL_A_CIDR=10.77.1.0/24
RAIL_A_IFACE=enp1s0f0np0
RAIL_A_HCA=rocep1s0f0
# DSCP 26 << 2. Must match the switch QoS profile (PFC on priority 3), or RoCE degrades
# silently instead of failing.
NCCL_IB_TC=106
# The RoCEv2/IPv4 GID index is found per node at launch from sysfs. It differs between nodes
# and moves after reboots, so it is never pinned here.

# Rail B is the transfer rail: rsyncd on each node binds only there (module "models" = /var/tmp).
RAIL_B_IPS=(10.77.2.11 10.77.2.12 10.77.2.13 10.77.2.14)

# Where the recipe lives on the nodes (shipped with launch/cluster.sh ship, from git archive HEAD).
REPO_DIR=/home/mtxc/dsv41

MODEL_DIR=/var/tmp/models/DeepSeek-V4.1-Flash
# Full Engram shards, downloaded once to the download node (NODES[0]); slices are cut there.
ENGRAM_CACHE_DIR=/var/tmp/models/DeepSeek-V4.1-Flash-engram-full
SLICE_STAGING=/var/tmp/dsv41-slices
SLICE_BWLIMIT=400m
MODEL_REVISION=dba1be0a40aa45a94ad051997016db3960a90277
CACHE_DIR=/var/tmp/dsv41-vllm-cache
PATCH_ROOT=/var/tmp/dsv41-patches

IMAGE=vllm-dsv41:172d9a17
CONTAINER=vllm_dsv41
# The API has no auth. It listens on the head's rail A address only, which is where the
# LiteLLM proxy on spark-01 already points (VLLM_BASE=http://10.77.1.11:8000/v1): not on the
# management network, not on 0.0.0.0.
API_HOST=10.77.1.11
API_PORT=8000
MASTER_PORT=29541

# Serving shape. 0xTank's measured configuration was 600K/K3; lever L3 (K5, 300K) is accepted since
# 2026-09-19: +11 % single-stream, +4 % at six streams, at half the request length. Change one
# value at a time and record it (docs/LEVERS.md).
PATCH_SET=measured
MAXLEN=300000
SPEC_K=5
GMU=0.80
SEQS=8
MAX_BATCHED=8192
COMPACT_O_PROJ=1

# Accepted levers (docs/LEVERS.md). L1, NCCL connection buffers: +13 % C1, +11 % C6, ~10 GiB
# back per node on this cluster. Delete the line to run the plain measured baseline.
LEVER_ENV="NCCL_BUFFSIZE=1048576 NCCL_LL128_BUFFSIZE=262144 NCCL_PROTO=^LL128 NCCL_MAX_NCHANNELS=8"
