FROM vllm/vllm-openai:nightly-8a728663c1c3eeace834a95f5654fa653cc1998c
# vLLM Python tree at 172d9a17 plus the _C_stable_libtorch built by stable-extension.sh.
# The base nightly is the merge-base of the day-0 dsv41-feat branch; 0xTank's measured build
# overlays the rewritten branch's tree on it the same way.
COPY vllm/ /usr/local/lib/python3.12/dist-packages/vllm/
RUN find /usr/local/lib/python3.12/dist-packages/vllm -name "__pycache__" -type d -prune -exec rm -rf {} + \
 && python3 -c "import vllm; print(vllm.__version__)"
